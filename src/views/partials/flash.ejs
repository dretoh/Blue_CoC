<% if (typeof errors !== 'undefined' && errors && errors.length) { %>
  <div class="alert alert-err">
    <svg class="ic" width="17" height="17" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 4.2a.9.9 0 01.9.9v4a.9.9 0 11-1.8 0v-4a.9.9 0 01.9-.9zm0 8.6a1.1 1.1 0 110-2.2 1.1 1.1 0 010 2.2z"/></svg>
    <div>
      <% if (errors.length === 1) { %>
        <%= errors[0] %>
      <% } else { %>
        <strong>입력을 확인해 주세요.</strong>
        <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul>
      <% } %>
    </div>
  </div>
<% } %>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="alert alert-ok">
    <svg class="ic" width="17" height="17" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm3.7 6.2l-4.3 4.3a.9.9 0 01-1.3 0L6.3 10.7a.9.9 0 111.3-1.3l1.2 1.2 3.6-3.7a.9.9 0 111.3 1.3z"/></svg>
    <div><%= notice %></div>
  </div>
<% } %>

<% if (typeof sessionError !== 'undefined' && sessionError === 'ip_mismatch') { %>
  <div class="alert alert-warn">
    <svg class="ic" width="17" height="17" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.1 3.2a1 1 0 011.8 0l7 12.3a1 1 0 01-.9 1.5H3a1 1 0 01-.9-1.5zM10 7.4a.9.9 0 00-.9.9v3a.9.9 0 101.8 0v-3a.9.9 0 00-.9-.9zm0 7.2a1.05 1.05 0 100-2.1 1.05 1.05 0 000 2.1z"/></svg>
    <div>보안을 위해 세션은 발급된 접속 IP 에서만 사용할 수 있습니다. 현재 IP(<code><%= clientIp %></code>)에서는 무효 처리되어 로그아웃되었습니다.</div>
  </div>
<% } %>
