<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page narrow">
  <div class="page-head">
    <div>
      <h1>새 문의 작성</h1>
      <p class="sub">작성하신 내용은 담당 관리자와 본인만 확인할 수 있습니다.</p>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <div class="card card-pad">
    <form method="post" action="/inquiries">
      <div class="field">
        <label for="title">제목</label>
        <input id="title" name="title" required autofocus maxlength="200"
               placeholder="문의 내용을 한 줄로 요약해 주세요"
               value="<%= typeof form !== 'undefined' && form.title ? form.title : '' %>">
      </div>

      <div class="field">
        <label for="body">내용</label>
        <textarea id="body" name="body" required maxlength="20000"
                  placeholder="문의하실 내용을 자세히 적어주세요."><%= typeof form !== 'undefined' && form.body ? form.body : '' %></textarea>
        <p class="help">서식이 필요하시면 HTML 태그를 사용하실 수 있습니다.</p>
      </div>

      <div class="row" style="margin-top:22px">
        <button class="btn btn-primary" type="submit">문의 등록</button>
        <a class="btn btn-ghost" href="/inquiries">취소</a>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
