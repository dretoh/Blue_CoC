<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="page narrow">
  <a class="btn btn-ghost btn-sm" href="/inquiries" style="margin-bottom:16px;padding-left:6px">
    <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10H5M9 6l-4 4 4 4"/></svg>
    문의 목록
  </a>

  <div class="detail-head">
    <h1><%= inquiry.title %></h1>
    <div class="detail-meta">
      <span class="tag tag-<%= inquiry.status %>">
        <%= inquiry.status === 'open' ? '접수됨' : (inquiry.status === 'answered' ? '답변완료' : '종료') %>
      </span>
      <span>#<%= inquiry.id %></span>
      <span class="dot">·</span>
      <span><%= inquiry.author_username %></span>
      <span class="dot">·</span>
      <time><%= new Date(inquiry.created_at).toLocaleString('ko-KR', { dateStyle: 'medium', timeStyle: 'short' }) %></time>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <div class="stack-lg">
    <div class="card">
      <%
        /*
          CoC 02 / 지정된 Stored-XSS
          문의 본문은 의도적으로 이스케이프하지 않고 그대로 렌더링한다.
          명세가 지정한 유일한 공격 표면이며, 그 외 모든 출력은 이스케이프된다.
        */
      %>
      <div class="inq-body"><%- inquiry.body %></div>
    </div>

    <div class="card">
      <div class="card-head">
        <h2>답변</h2>
        <span class="count"><%= replies.length %>건</span>
      </div>

      <% if (!replies.length) { %>
        <div class="empty" style="padding:38px 24px">
          <h3>아직 답변이 없습니다</h3>
          <p>담당자가 확인 후 답변드리겠습니다.</p>
        </div>
      <% } else { %>
        <% replies.forEach(function (r) { %>
          <div class="reply">
            <span class="avatar <%= r.author_role === 'admin' ? 'is-admin' : '' %>"><%= r.author_username.charAt(0).toUpperCase() %></span>
            <div class="reply-body">
              <div class="reply-who">
                <b><%= r.author_username %></b>
                <% if (r.author_role === 'admin') { %><span class="tag tag-plain tag-new">관리자</span><% } %>
                <time><%= new Date(r.created_at).toLocaleString('ko-KR', { dateStyle: 'medium', timeStyle: 'short' }) %></time>
              </div>
              <div class="reply-text"><%= r.body %></div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <div class="card card-pad">
      <form method="post" action="/inquiries/<%= inquiry.id %>/replies">
        <div class="field">
          <label for="reply">답변 남기기</label>
          <textarea id="reply" name="body" required maxlength="20000" style="min-height:130px"
                    placeholder="<%= isAdmin ? '고객님께 안내할 내용을 입력하세요.' : '추가로 전달하실 내용을 입력하세요.' %>"></textarea>
        </div>
        <button class="btn btn-primary" type="submit" style="margin-top:16px">답변 등록</button>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
