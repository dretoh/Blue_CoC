<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="auth">
  <div class="auth-box">
    <div class="auth-head">
      <h1>회원가입</h1>
      <p>아이디, 비밀번호, 이메일만 입력하면 바로 시작할 수 있습니다.</p>
    </div>

    <%- include('partials/flash') %>

    <div class="card card-pad">
      <form method="post" action="/register">
        <div class="field">
          <label for="username">아이디</label>
          <input id="username" name="username" required autofocus autocomplete="username"
                 value="<%= typeof form !== 'undefined' && form.username ? form.username : '' %>">
          <p class="help">영문·숫자와 <code>. _ -</code> 조합 3~32자</p>
        </div>

        <div class="field">
          <label for="email">이메일</label>
          <input id="email" name="email" type="email" required autocomplete="email"
                 value="<%= typeof form !== 'undefined' && form.email ? form.email : '' %>">
          <p class="help">비밀번호를 잊었을 때 본인 확인에 사용됩니다.</p>
        </div>

        <div class="field">
          <label for="password">비밀번호</label>
          <input id="password" name="password" type="password" required autocomplete="new-password">
          <p class="help">8자 이상</p>
        </div>

        <button class="btn btn-primary btn-block" type="submit" style="margin-top:22px">가입하기</button>
      </form>
    </div>

    <p class="auth-foot">이미 계정이 있으신가요? <a href="/login">로그인</a></p>
  </div>
</main>

<%- include('partials/footer') %>
