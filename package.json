{
  "name": "blue-cell-service",
  "version": "1.0.0",
  "private": true,
  "description": "Episode 1 : 감염된 챗봇 — Blue Team mission service (고객지원 포털 + 계정복구 챗봇)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
