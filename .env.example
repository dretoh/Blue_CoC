# ---- server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# 리버스 프록시(nginx / cloudflare / ngrok) 뒤에 둘 때만 신뢰할 hop 수를 지정한다.
# 0 = X-Forwarded-For 무시 (헤더 위조로 IP 바인딩을 우회할 수 없음)
TRUST_PROXY_HOPS=0

# HTTPS 로 배포할 때만 true
COOKIE_SECURE=false

SESSION_TTL_MIN=720
RESET_TOKEN_TTL_MIN=30

# ---- LLM (MODEL LOCK: llama-3.2-3b-instruct) ----
# PDF 명세의 모델은 llama-3.2-3b-instruct 이며 코드에 고정되어 있습니다.
# LLM_MODEL_ID 는 "공급자별 표기"만 바꾸는 값이고,
# Llama 3.2 3B 계열이 아니면 서버가 기동 자체를 거부합니다.

# [기본] OpenRouter — https://openrouter.ai/keys 에서 키 발급 후 아래에 붙여넣기
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_ID=meta-llama/llama-3.2-3b-instruct

# 무료 변형을 쓰려면 (속도 느리고 대기열 있음):
# LLM_MODEL_ID=meta-llama/llama-3.2-3b-instruct:free

# [대안] Together AI
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=
# LLM_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct-Turbo

LLM_TIMEOUT_MS=30000

# LLM 호출이 실패했을 때 규칙 기반 폴백으로 계속 동작할지 여부.
# 키를 넣고 정상 동작을 확인했다면 false 로 두세요.
ALLOW_LLM_FALLBACK=true

# ---- seed accounts ----
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=Admin!2345
SEED_ADMIN_EMAIL=admin@bluecell.local
SEED_USER_USER=user
SEED_USER_PASS=User!2345
SEED_USER_EMAIL=user@bluecell.local
